bin/sim_output.json

# Die heruntergeladene CLI selbst (22 MB). Wird von den Sim-Skripten bei Bedarf
# automatisch von github.com/wowsims/tbc-new/releases/latest geholt.
bin/wowsimcli-windows.exe
bin/wowsims.zip

